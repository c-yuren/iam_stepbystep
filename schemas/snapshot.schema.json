{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized assembly snapshot for Inventor drawing MVP",
  "type": "object",
  "required": ["model_path", "components"],
  "properties": {
    "model_path": {"type": "string", "pattern": "\\.[iI][aA][mM]$"},
    "provenance": {"type": "string"},
    "components": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "name"], "properties": {
      "id": {"type": "string", "minLength": 1},
      "name": {"type": "string", "minLength": 1},
      "scope": {"type": "string"},
      "source": {"type": "string"},
      "confidence": {"enum": ["verified", "inferred", "unknown"]}
    }, "additionalProperties": true}}
  },
  "additionalProperties": true
}
